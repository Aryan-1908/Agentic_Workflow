{
  "about": "Capacity / saturation probe set. Separate from the M8 eval (which the spec caps at 15-20 incidents) because this is an investigation into one failure shape: pressure surfacing somewhere other than its cause. Every case here is 'nothing is broken, something is full', where the dependency graph and the evidence can disagree. forbid_sent lists what must never reach the shop even if a rubber-stamp approver waves it through.",
  "scenarios": [
    {
      "scenario": "pool_exhaustion",
      "use_case": "capacity trap",
      "approver": "rubber-stamp",
      "traps": [
        "capacity"
      ],
      "incidents": [
        {
          "root": "orders-api",
          "actions": [
            "escalate",
            "none"
          ],
          "lanes": [
            "escalate",
            "approval"
          ],
          "ends": [
            "escalated",
            "closed: no action needed"
          ]
        }
      ],
      "forbid_sent": [
        [
          "vm.start",
          "db-01"
        ],
        [
          "vm.reset",
          "db-01"
        ],
        [
          "service.restart",
          "db-01"
        ]
      ]
    },
