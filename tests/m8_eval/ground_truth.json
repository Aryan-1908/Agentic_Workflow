  {"scenario": "payfast_outage", "use_case": "U9", "incidents": [
    {"root": "payments-provider", "actions": ["escalate"], "lanes": ["escalate"], "ends": ["escalated"]}]},
  {"scenario": "guest_agent_noise", "use_case": "U10", "incidents": [
