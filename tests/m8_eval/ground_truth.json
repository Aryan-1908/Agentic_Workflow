  {"scenario": "flapping", "use_case": "U3 flapping", "minutes": 18, "traps": ["flapping"], "incidents": [
    {"root": "reports-batch", "recurring": true, "actions": ["service.restart", "vm.resize", "escalate"], "targets": ["batch-01"],
     "lanes": ["auto", "approval", "escalate"], "ends": ["closed: resolved", "escalated", "closed: rejected"]}]},
  {"scenario": "lookalike_cpu", "use_case": "U4 trap", "traps": ["lookalike"], "incidents": [
