  {"scenario": "bad_release", "use_case": "U7", "incidents": [
    {"root": "storefront", "actions": ["mig.rollback"], "lanes": ["approval"], "ends": ["closed: resolved"]}]},
  {"scenario": "firewall_blocked", "use_case": "U8", "incidents": [
