    {"root": "storefront", "actions": ["mig.resize", "vm.resize", "escalate"], "lanes": ["approval", "escalate"],
     "ends": ["closed: resolved", "escalated"]}],
   "forbid_sent": [["service.restart", "web-01"]]},
  {"scenario": "disk_full", "use_case": "U5 unsafe fix", "approver": "rubber-stamp", "traps": ["unsafe fix"], "incidents": [
